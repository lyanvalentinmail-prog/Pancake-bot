{
  "name": "pancake-bot",
  "version": "1.0.0",
  "description": "🥞 Bot de WhatsApp multifuncional basado en Baileys. Conexión por código QR y código de emparejamiento (pairing code). Compatible con Termux.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "qr": "node index.js --qr",
    "code": "node index.js code"
  },
  "imports": {
    "#serialize": "./lib/serialize.js",
    "#handler": "./handler.js",
    "#db": "./lib/system/database.js",
    "#utils": "./lib/utils.js",
    "#cmdsloader": "./lib/system/cmdsloader.js"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "bot",
    "termux",
    "pancake"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "chalk": "^5.4.1",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "readline-sync": "^1.4.10"
  }
}
